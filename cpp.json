	"DS_XORBASIS": {
		"prefix": "XORBASIS",
		"body": [
			"const int B = ${1:20};",
			"",
			"struct XorBasis {",
			"    std::vector<int> basis;",
			"    std::vector<int> who;",
			"",
			"    int sz;",
			"",
			"    void reset() {",
			"        basis.assign(B, 0);",
			"        who.clear();",
			"        sz = 0;",
			"    }",
			"",
			"    bool add(int x, int index) {",
			"        for (int i = B - 1; i >= 0; i--) {",
			"            if (x >> i & 1) {",
			"                if (!basis[i]) {",
			"                    basis[i] = x;",
			"                    who.push_back(index);",
			"                    sz++;",
			"                    return true;",
			"                }",
			"                x ^= basis[i];",
			"            }",
			"        }",
			"        return false;",
			"    }",
			"",
			"    int kth(int k) { // al k-lea cel mai mic subset xor",
			"        if (k < 1 || k > (1 << sz)) {",
			"            return -1;",
			"        }",
			"        int x = 0;",
			"        int cnt = (1 << sz);",
			"        for (int i = B - 1; i >= 0; i--) {",
			"            if (basis[i]) {",
			"                if (k > cnt / 2) {",
			"                    if (!(x >> i & 1)) {",
			"                        x ^= basis[i];",
			"                    }",
			"                    // il fac sa fie 1",
			"                    k -= cnt / 2;",
			"                } else {",
			"                    // il fac sa fie 0",
			"                    if (x >> i & 1) {",
			"                        x ^= basis[i];",
			"                    }",
			"                }",
			"                cnt /= 2;",
			"            }",
			"        }",
			"        return x;",
			"    }",
			"",
			"    int count_le(int x) { // cate subset uri au xor < x?",
			"        if (x < 0) {",
			"            return 0;",
			"        }",
			"        int ret = 0;",
			"        int cnt = (1 << sz);",
			"        int mask = 0;",
			"        for (int i = B - 1; i >= 0; i--) {",
			"            if (basis[i]) {",
			"                if (x >> i & 1) {",
			"                    ret += cnt / 2;",
			"                    if (!(mask >> i & 1)) {",
			"                        mask ^= basis[i];",
			"                    }",
			"                } else {",
			"                    if (mask >> i & 1) {",
			"                        mask ^= basis[i];",
			"                    }",
			"                }",
			"                cnt /= 2;",
			"            } else {",
			"                if ((x ^ mask) >> i & 1) {",
			"                    if (x >> i & 1) {",
			"                        return ret + cnt;",
			"                    } else {",
			"                        return ret;",
			"                    }",
			"                }",
			"            }",
			"        }",
			"        return ret;",
			"    }",
			"    int count_leq(int x) { // <= x",
			"        return count_le(x + 1);",
			"    }",
			"    int jumpK(int value, int k) {",
			"        int p = count_leq(value);",
			"        return kth(p + k);",
			"    }",
			"};",
			""
		],
		"description": "DATA STRUCTURE"
	},
	"DS_UF": {
		"prefix": "UF",
		"body": [
			"struct UF {",
			"    int n;",
			"    vector<int> par;",
			"    UF(int _n) : n(_n) {",
			"        for (int i = 0; i < n; i++) par.push_back(i);",
			"    }",
			"    int find(int a) {",
			"        if (a != par[a]) par[a] = find(par[a]);",
			"        return par[a];",
			"    }",
			"    bool join(int a, int b) {",
			"        a = find(a);",
			"        b = find(b);",
			"        par[a] = b;",
			"        return a != b;",
			"    }",
			"};",
		]
	},
	"DS_TREAP_FHQ": {
		"prefix": "TREAP_FHQ",
		"body": [
			"",
			"mt19937 mt_treap(4823);",
			"",
			"template<typename T>",
			"struct node {",
			"    int cnt;",
			"    T v, lazy;",
			"    int64_t p;",
			"",
			"    node *l, *r;",
			"    node(T _v) : cnt(1), v(_v), lazy(0), p(mt_treap()), l(nullptr), r(nullptr) {}",
			"};",
			"",
			"template<typename T>",
			"void push(node<T> *t) {",
			"    if (t == nullptr) return;",
			"    if (t->lazy) {",
			"        if (t->l != nullptr) {",
			"            t->l->lazy += t->lazy;",
			"            t->l->v += t->lazy;",
			"        }",
			"        if (t->r != nullptr) {",
			"            t->r->lazy += t->lazy;",
			"            t->r->v += t->lazy;",
			"        }",
			"        t->lazy = 0;",
			"    }",
			"}",
			"",
			"template<typename T>",
			"int cnt(node<T> *t) {",
			"    return t == nullptr ? 0 : t->cnt;",
			"}",
			"",
			"template<typename T>",
			"void splitv(node<T> *t, node<T> *&l, node<T> *&r, T v) { // splits into <= v and > v",
			"    if (t == nullptr) {",
			"        l = nullptr;",
			"        r = nullptr;",
			"    } else if (t->v < v) {",
			"        push(t);",
			"        splitv(t->r, t->r, r, v);",
			"        l = t;",
			"    } else {",
			"        push(t);",
			"        splitv(t->l, l, t->l, v);",
			"        r = t;",
			"    }",
			"}",
			"template<typename T>",
			"void merge(node<T> *&t, node<T> *l, node<T> *r) {",
			"    if (l == nullptr) {",
			"        t = r;",
			"    } else if (r == nullptr) {",
			"        t = l;",
			"    } else if (l->p < r->p) {",
			"        push(l);",
			"        merge(l->r, l->r, r);",
			"        t = l;",
			"    } else {",
			"        push(r);",
			"        merge(r->l, l, r->l);",
			"        t = r;",
			"    }",
			"}",
			"",
			"template<typename T>",
			"void pt(node<T> *r) {",
			"    if (r == nullptr) return;",
			"    pt(r->l);",
			"    cout << r->v << \"\" << r->p << \"\" << r->cnt << endl;",
			"    pt(r->r);",
			"}",
			"",
			"template<typename T>",
			"void treap_union(vector<pair<T, T>> &store, node<T> *&t, node<T> *l, node<T> *r) {",
			"    if (l == nullptr) {",
			"        t = r;",
			"    } else if (r == nullptr) {",
			"        t = l;",
			"    } else {",
			"        push(l);",
			"        push(r);",
			"        if (l->p > r->p) swap(l, r);",
			"        node<T> *a, *b, *c;",
			"        splitv(r, a, b, l->v);",
			"        splitv(b, b, c, l->v + 1);",
			"        if (b) {",
			"            store.push_back({l->cnt, b->cnt});",
			"            l->cnt += b->cnt;",
			"            delete b;",
			"        }",
			"        treap_union(store, l->l, l->l, a);",
			"        treap_union(store, l->r, l->r, c);",
			"        t = l;",
			"    }",
			"}"
		]
	},
