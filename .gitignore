
bin/*
lib/*
*.dSYM/*
TEST/*
*.out
*.txt

main
main_*
main2
std
std_*
# the patterns above only target run.sh's bare-name scratch binaries
# (./main, ./main_fast, ./std, ...) - keep real source files tracked
# regardless of a main*/std* prefix (main2.cpp, main.py, std.cpp, ...).
!*.cpp
!*.c
!*.h
!*.hpp
!*.py
!*.sh
!*.md

# GCC/Clang compiler-internals dump artifacts (-fdump-tree-all, GIMPLE/RTL passes, etc.)
*.cpp.*

# Preprocessed source dumps (clang -E / -save-temps)
*.i

# LLVM PGO instrumentation output
*.profraw
*.profdata

# Clang C++20 module cache
gcm.cache/

# Generated/disassembled asm dumps (run.sh/objdump scratch output)
*.s

# Machine-specific clangd config (hardcodes a local LLVM install path)
.clangd

# Compiled scratch binaries / shared objects from ad-hoc experiments
*.so
*.dylib
.tmp_main_*
/gen
/o3_unroll4
/pgo_benchmark
/pgo_optimized
/pgo_unroll16
/scc_compare
/scc_parallel
/test_app
/vuln
/patch
/old

# macOS Finder metadata
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc