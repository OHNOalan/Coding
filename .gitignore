
# run.sh's build output: binaries, .dSYM bundles, result.txt — everything
# it produces lives here now, nothing spills into the repo root anymore.
.build/

# Editor state: personal/machine-specific, not meant to be shared across
# clones (unlike .githooks/, which bootstrap.sh wires up on every clone and
# stays tracked on purpose). Kept locally, just not pushed.
.vscode/
.idea/

bin/*
lib/*
*.dSYM/*
TEST/*
*.out
*.txt
# scratch/in.txt and scratch/out.txt are the actual tracked skip-worktree
# placeholders (see scratch/, bootstrap.sh) — the *.txt rule above is meant
# for ad-hoc result/test-output txt files, not these two.
!scratch/in.txt
!scratch/out.txt

main
main_*
main2
std
std_*
# the patterns above are a leftover safety net from before run.sh's output
# moved into .build/ — kept in case something else ever compiles a bare
# ./main or ./std binary at the repo root. Keep real source files tracked
# regardless of a main*/std* prefix (main2.cpp, main.py, std.cpp, ...).
!*.cpp
!*.c
!*.h
!*.hpp
!*.py
!*.sh
!*.md

# GCC/Clang compiler-internals dump artifacts (-fdump-tree-all, GIMPLE/RTL passes, etc.)
*.cpp.*

# Preprocessed source dumps (clang -E / -save-temps)
*.i

# LLVM PGO instrumentation output
*.profraw
*.profdata

# Clang C++20 module cache
gcm.cache/

# Generated/disassembled asm dumps (run.sh/objdump scratch output)
*.s

# Machine-specific clangd config (hardcodes a local LLVM install path)
.clangd

# Compiled scratch binaries / shared objects from ad-hoc experiments
*.so
*.dylib
.tmp_main_*
/gen
/o3_unroll4
/pgo_benchmark
/pgo_optimized
/pgo_unroll16
/scc_compare
/scc_parallel
/test_app
/vuln
/patch
/old

# macOS Finder metadata
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc